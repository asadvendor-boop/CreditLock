# CreditLock environment configuration
# Copy to .env and fill in real values. Never commit .env.

# ── Google Cloud ──────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# ── Vertex AI / Gemini ────────────────────────────────────────────────────────
GEMINI_ENTERPRISE_LOCATION=global
GEMINI_EXTRACTOR_MODEL=gemini-3.6-flash
GEMINI_EXTRACTOR_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_RESOLVER_MODEL=gemini-3.1-pro-preview
GEMINI_RESOLVER_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_STEWARD_MODEL=gemini-3.5-flash-lite
GEMINI_STEWARD_FALLBACK_MODEL=gemini-3.6-flash
VERTEX_AI_AGENT_ENGINE_ID=

# ── Firestore ─────────────────────────────────────────────────────────────────
FIRESTORE_DATABASE=(default)

# ── Cloud Storage ─────────────────────────────────────────────────────────────
EVIDENCE_BUCKET=

# ── Confluent Cloud ───────────────────────────────────────────────────────────
CONFLUENT_BOOTSTRAP_SERVERS=
CONFLUENT_API_KEY=
CONFLUENT_API_SECRET=
CONFLUENT_SCHEMA_REGISTRY_URL=
CONFLUENT_SCHEMA_REGISTRY_API_KEY=
CONFLUENT_SCHEMA_REGISTRY_API_SECRET=
CONFLUENT_TOPIC=creditlock.production.events
CONFLUENT_MCP_SERVER_URL=

# ── Auth (Production startup requires injected JWT_SECRET) ───────────────────
# MANDATORY: JWT_SECRET must be explicitly provided in environment.
# Production startup will fail if JWT_SECRET is missing or empty.
# Do NOT place usable default secrets in this file.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Render profile ────────────────────────────────────────────────────────────
RENDER_PROFILE_VERSION=v1
CHROMIUM_EXECUTABLE=

# ── Gate policy ───────────────────────────────────────────────────────────────
GATE_POLICY_VERSION=v1
